# Auto-normalize line endings to LF for all text files
* text=auto eol=lf

# Ensure shell scripts always use LF (required for macOS/Linux/CI)
gradlew text eol=lf

# Code and configuration files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jar binary
